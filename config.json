{
  "server": {
    "host": "127.0.0.1",
    "port": 4390
  },
  "runtime": {
    "adapter": "ollama",
    "ollamaUrl": "http://127.0.0.1:11434",
    "llamaCppUrl": "http://127.0.0.1:8080",
    "ollamaBin": "",
    "ollamaEnv": {
      "OLLAMA_MODELS": "N:\\ollama-models",
      "OLLAMA_FLASH_ATTENTION": "1",
      "OLLAMA_KV_CACHE_TYPE": "q8_0",
      "OLLAMA_CONTEXT_LENGTH": "16384"
    }
  },
  "storage": {
    "chatsDir": "N:/landslide-local/chats",
    "modelsDir": "N:/models",
    "logFile": "./logs/app.log"
  },
  "hardware": {
    "vramTotalGb": 8,
    "vramUsableGb": 6.65,
    "label": "RTX 5060 8GB"
  },
  "security": {
    "token": "",
    "encryptChats": false
  }
}
